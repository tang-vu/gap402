{
  "name": "gap402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter='!@gap402/web' run build && pnpm --filter @gap402/web run build",
    "dev": "pnpm --parallel --filter=@gap402/api --filter=@gap402/web run dev",
    "test": "pnpm -r run test",
    "test:contracts": "cd contracts && arc-forge test --network arc -vvv",
    "typecheck": "pnpm -r run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "demo": "tsx scripts/demo.ts",
    "demo:mainnet": "tsx scripts/demo-mainnet.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.18.0"
  },
  "keywords": [
    "arc",
    "usdc",
    "x402",
    "agents",
    "evidence",
    "bounty",
    "ai-agents"
  ],
  "license": "MIT"
}
