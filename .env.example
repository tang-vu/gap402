# ── Network selection ────────────────────────────────────────────────
# One of: local | testnet | mainnet
GAP402_NETWORK=local

# Local node (arc-anvil --network arc, or any standard anvil)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Arc Testnet (official, verified 2026-09-17 against docs.arc.io)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://explorer.testnet.arc.io

# Arc Mainnet (official, verified 2026-09-17 against docs.arc.io)
# NOTE: mainnet may be permissioned during the private-mainnet phase.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_EXPLORER=https://explorer.arc.io

# USDC ERC-20 interface (same address on mainnet + testnet, 6 decimals).
# https://docs.arc.io/arc/references/contract-addresses
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Deployed gap402 contracts (filled by scripts/deploy.ts) ─────────
GAP_BOUNTY_ADDRESS=
RECEIPT_REGISTRY_ADDRESS=

# ── Keys (never commit) ──────────────────────────────────────────────
# Required for any mode that sends transactions.
PRIVATE_KEY=

# ── Mainnet safety gates ─────────────────────────────────────────────
# All must be set for ANY mainnet transaction.
MAINNET_ENABLED=false
# Hard cap on total USDC the demo scripts will spend in one run.
MAX_DEMO_SPEND_USDC=0.10

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4020
API_HOST=127.0.0.1
DATABASE_URL=sqlite:./data/gap402.db

# ── Verifier (optional; mock verifier works without any key) ─────────
VERIFIER_PROVIDER=mock
# VERIFIER_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
